---
import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EntryList from "../components/EntryList.astro";
import profileImage from "../assets/content/me 2.webp";

const home = await getEntry("pages", "home");
const posts = (await getCollection("blog")).sort(
  (a, b) => Number(b.data.date ?? 0) - Number(a.data.date ?? 0),
);
const { Content } = home ? await render(home) : { Content: undefined };
---

<BaseLayout>
  <section class="home-simple">
    <Image src={profileImage} alt="Syed Mohsin" width={180} height={180} />
    {
      Content && (
        <section class="prose home-copy">
          <Content />
        </section>
      )
    }
  </section>

  <section class="home-posts" aria-label="Blog posts">
    <EntryList entries={posts} basePath="/blog" />
  </section>
</BaseLayout>

<style>
  .home-simple {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    padding-top: 2rem;
  }

  .home-simple :global(img) {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
  }

  .home-copy :global(h1:first-child),
  .home-copy :global(h2:first-child) {
    margin-top: 0;
  }

  .home-posts {
    margin-top: 1.5rem;
  }

  @media (max-width: 680px) {
    .home-simple {
      grid-template-columns: 1fr;
      padding-top: 1.25rem;
      gap: 1.25rem;
    }
  }
</style>
