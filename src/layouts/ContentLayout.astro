---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry:
    | CollectionEntry<"blog">
    | CollectionEntry<"leetcode">
    | CollectionEntry<"pages">;
}

const { entry } = Astro.props;
const formatter = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="prose">
    <p class="kicker">
      {entry.data.date ? formatter.format(entry.data.date) : "Note"}
    </p>
    <h1>{entry.data.title}</h1>
    {
      entry.data.cover && !entry.data.hideCover && (
        <Image
          class="hero-image"
          src={entry.data.cover}
          alt={entry.data.coverAlt ?? ""}
          widths={[640, 960, 1280]}
          sizes="(max-width: 840px) 100vw, 760px"
        />
      )
    }
    <slot />
  </article>
</BaseLayout>

<style>
  .prose > .kicker {
    margin-bottom: 0.6rem;
  }

  .prose > h1 {
    margin: 0 0 1.1rem;
  }

  .hero-image {
    width: 100%;
    height: clamp(220px, 42vh, 420px);
    margin: 0 0 2rem;
    object-fit: contain;
    object-position: center;
    background: var(--code);
  }

  .prose > :where(p, h2, h3, h4, ul, ol, pre, table, blockquote):first-of-type {
    margin-top: 0;
  }
</style>
