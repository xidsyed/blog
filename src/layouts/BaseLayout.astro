---
interface Props {
  title?: string;
  description?: string;
}

const siteTitle = "sidequests";
const {
  title,
  description = "Software notes, projects, and side quests by Syed Mohsin.",
} = Astro.props;
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">sidequests</a>
      <nav aria-label="Primary navigation">
        <a href="/blog/">Blog</a>
        <a href="/leetcode/">LeetCode</a>
        <a href="/resume/">Resume</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #f7f7f3;
    --text: #242827;
    --muted: #66706d;
    --line: #dfe3df;
    --accent: #2d7f78;
    --accent-strong: #164f4a;
    --surface: #ffffff;
    --code: #eef2ef;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #101211;
      --text: #edf1ef;
      --muted: #9ca8a4;
      --line: #29312f;
      --accent: #7fc8bc;
      --accent-strong: #b9eee6;
      --surface: #171b1a;
      --code: #1f2725;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    line-height: 1.65;
  }

  a {
    color: var(--accent-strong);
    text-decoration-color: color-mix(in srgb, var(--accent), transparent 35%);
    text-underline-offset: 0.18em;
  }

  img,
  video {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  video {
    background: var(--code);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 980px;
    margin: 0 auto;
    padding: 1.2rem;
  }

  .brand {
    color: var(--text);
    font-weight: 800;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  nav a {
    color: var(--muted);
    font-size: 0.95rem;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  main {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 1.2rem 4rem;
  }

  .prose {
    max-width: 760px;
  }

  .prose h1 {
    margin: 2rem 0 0.4rem;
    font-size: clamp(2.2rem, 8vw, 4.6rem);
    line-height: 0.95;
    letter-spacing: 0;
  }

  .prose h2,
  .prose h3 {
    line-height: 1.15;
    margin-top: 2rem;
  }

  .prose p,
  .prose li {
    font-size: 1.04rem;
  }

  .prose img,
  .prose picture,
  .prose video {
    display: block;
    margin-inline: auto;
  }

  .prose pre {
    width: min(100%, calc(980px - 2.4rem));
    max-width: none;
    margin-inline: 50%;
    transform: translateX(-50%);
    overflow-x: auto;
    padding: 1rem;
    border-radius: 8px;
    background: var(--code);
  }

  .prose code {
    font-size: 0.92em;
  }

  .prose :not(pre) > code {
    padding: 0.12rem 0.3rem;
    border-radius: 5px;
    background: var(--code);
  }

  .prose table {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .prose th,
  .prose td {
    padding: 0.5rem;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }

  .kicker {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .section-title {
    margin: 2rem 0 0.5rem;
    font-size: clamp(2rem, 7vw, 4rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .lede {
    max-width: 700px;
    color: var(--muted);
    font-size: 1.1rem;
  }

  @media (max-width: 640px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      justify-content: flex-start;
    }
  }
</style>
